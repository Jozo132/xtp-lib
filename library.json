{
  "name": "xtp-lib",
  "version": "0.1.9",
  "description": "XTP Board helper library",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jozo132/xtp-lib.git"
  },
  "keywords": ["ethernet", "stm32", "xtp"],
  "frameworks": ["arduino"],
  "platforms": ["ststm32"],
  "dependencies": [
    {
      "name": "stm32duino/STM32duino LwIP",
      "version": "2.2.1"
    }
  ],
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "srcFilter": [
      "-<*>",
      "+<SpiNorFlash.cpp>",
      "+<lan8740_lwip.cpp>",
      "+<xtp_ethernet_lwip.cpp>",
      "+<xtp_lwip_compat.cpp>"
    ]
  }
}
