{
  "name": "xtp-lib",
  "version": "0.1.9",
  "description": "XTP Board helper library",
  "keywords": ["ethernet", "stm32", "xtp"],
  "frameworks": ["arduino"],
  "platforms": ["ststm32"],
  "build": {
    "srcDir": "src",
    "includeDir": "src/lwip/src/include",
    "srcFilter": [
      "-<*>",
      "+<SpiNorFlash.cpp>",
      "+<lan8740_lwip.cpp>",
      "+<xtp_ethernet_lwip.cpp>",
      "+<xtp_lwip_compat.cpp>",
      "+<lwip/src/core/**>",
      "+<lwip/src/netif/ethernet.c>"
    ]
  }
}
